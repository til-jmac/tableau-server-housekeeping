#!/bin/bash
# Stub of the Tableau tsm CLI for CI.
# STUB_BACKUP_DIR / STUB_ARCHIVE_DIR: what "configuration get" returns and where files are written.
# STUB_FAIL: version | status | config | backup | export | ziplogs | cleanup makes that command exit 1.
echo "[stub tsm] $*" >&2
fname=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  [ "${args[i]}" = "-f" ] && fname="${args[i + 1]}"
done
case "$1 $2" in
  "version "*) [ "$STUB_FAIL" = version ] && exit 1; echo "Tableau Services Manager version stub" ;;
  "status "*) [ "$STUB_FAIL" = status ] && exit 1; echo "Status: RUNNING" ;;
  "configuration get")
    [ "$STUB_FAIL" = config ] && exit 1
    case "$4" in
      basefilepath.backuprestore) echo "$STUB_BACKUP_DIR" ;;
      basefilepath.log_archive) echo "$STUB_ARCHIVE_DIR" ;;
      *) exit 99 ;;
    esac ;;
  "settings export") [ "$STUB_FAIL" = export ] && exit 1; echo '{}' > "$fname" ;;
  "maintenance backup")
    [ "$STUB_FAIL" = backup ] && exit 1
    f="$STUB_BACKUP_DIR/$fname-$(date +%Y-%m-%d).tsbak"
    if [ -e "$f" ]; then echo "Error: $f already exists" >&2; exit 1; fi
    echo backup > "$f" ;;
  "maintenance ziplogs") [ "$STUB_FAIL" = ziplogs ] && exit 1; echo zip > "$STUB_ARCHIVE_DIR/$fname" ;;
  "maintenance cleanup") [ "$STUB_FAIL" = cleanup ] && exit 1; echo "Cleanup done" ;;
  *) echo "stub tsm: unsupported command: $*" >&2; exit 99 ;;
esac
